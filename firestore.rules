rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.role;
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }
    
    function isTeacherOfClass(classId) {
      let classData = get(/databases/$(database)/documents/classes/$(classId)).data;
      return classData.teacherId == request.auth.uid;
    }
    
    // ========== КОЛЛЕКЦИЯ USERS ==========
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.uid == request.auth.uid;
      allow update: if isUser(userId) || isTeacher();
      allow delete: if false;
    }

    // ========== ИГРОВАЯ СТАТИСТИКА ==========
    match /gameStats/{userId} {
      allow read, write: if isUser(userId);
    }
    
    // ========== КОЛЛЕКЦИЯ CLASSES ==========
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ EXAMS (исправлено) ==========
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ STUDENT_PROGRESS ==========
    match /studentProgress/{progressId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isStudent() && resource.data.studentId == request.auth.uid;
      allow delete: if false;
    }
    
    // ========== КОЛЛЕКЦИЯ SUBMISSIONS ==========
    match /submissions/{submissionId} {
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if (isStudent() && 
                        resource.data.studentId == request.auth.uid && 
                        resource.data.status == 'pending' &&
                        !request.resource.data.keys().hasAny(['teacherGrade', 'status'])) 
                      || isTeacher();
      allow delete: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ GRADED_SUBMISSIONS ==========
    match /gradedSubmissions/{gradedId} {
      allow read: if isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create, update: if isTeacher();
      allow delete: if false;
    }
    
    // ========== КОЛЛЕКЦИЯ CARDS ==========
    match /cards/{cardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ CARD_PACKS ==========
    match /cardPacks/{packId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ SUBJECTS ==========
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }
    
    // ========== КОЛЛЕКЦИЯ AGGREGATED_STATS ==========
    match /aggregatedStats/{statId} {
      allow read: if isTeacher() && isTeacherOfClass(statId);
      allow create, update: if isTeacher() && isTeacherOfClass(statId);
      allow delete: if false;
    }
    
    // ========== СТАРЫЕ КОЛЛЕКЦИИ АНГЛИЙСКОГО (для миграции) ==========
    match /englishProgress/{userId} {
      allow read: if isUser(userId) || isTeacher();
      allow create: if isUser(userId);
      allow update: if isUser(userId);
      allow delete: if false;
    }
    
    match /englishPacks/{packId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========== НОВАЯ СТРУКТУРА АНГЛИЙСКОГО ==========
    match /english/{userId} {
      allow read: if isUser(userId) || isTeacher();
      allow write: if isUser(userId);
      
      match /progress {
        allow read: if isUser(userId) || isTeacher();
        allow write: if isUser(userId);
      }
      
      match /packs/{packId} {
        allow read: if isUser(userId) || isTeacher();
        allow write: if isUser(userId);
      }
      
      match /sm2/{docId} {
        allow read: if isUser(userId) || isTeacher();
        allow write: if isUser(userId);
      }
    }
  }
}